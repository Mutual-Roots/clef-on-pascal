# Host values for config.yaml - the only place with host paths. Copy to host.env and fill in.
# Read by fordiverse-llama-swap.service (EnvironmentFile); config.yaml refers to these via ${env.NAME}.
# A missing value makes llama-swap refuse to load the config. No secrets belong here.
# systemd EnvironmentFile: comments only on their own lines, no quotes needed.

# Directory that contains llama-server of the llama.cpp CUDA build.
FORDIVERSE_LLAMA_BIN=/path/to/llama.cpp-cuda/bin

# LD_LIBRARY_PATH for llama-server: the build directory plus the CUDA runtime bundle, ':'-separated.
FORDIVERSE_LLAMA_LIBPATH=/path/to/llama.cpp-cuda/bin:/path/to/cudart-bundle

# Model root in Hugging Face layout: <org>/<repo>/<revision>/<file>.gguf
FORDIVERSE_MODELLE=/path/to/models

# Persistent PTX-JIT cache (keep it out of /tmp so compiled kernels survive reboots).
FORDIVERSE_CUDA_CACHE=/path/to/cache/nv-computecache
